{
    "name": "ramn-ai-backend",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "deploy": "npm run build && sam deploy --guided",
        "local": "npm run build && sam local start-api --port 3001",
        "migrate:agent-tools": "node scripts/migrate-agent-tool-ids.js",
        "configure:s3-cors": "node scripts/set-s3-cors.js"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.1000.0",
        "@aws-sdk/client-dynamodb": "^3.1000.0",
        "@aws-sdk/client-s3": "^3.1000.0",
        "@aws-sdk/client-secrets-manager": "^3.1000.0",
        "@aws-sdk/lib-dynamodb": "^3.1000.0",
        "@aws-sdk/s3-request-presigner": "^3.1000.0",
        "aws-jwt-verify": "^5.1.1",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.145",
        "@types/node": "^22.19.11",
        "typescript": "~5.8.2"
    }
}
